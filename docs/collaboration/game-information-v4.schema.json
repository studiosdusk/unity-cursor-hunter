{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cursor Hunter resolved combat information v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "balanceVersion",
    "stats",
    "gemstones",
    "monsters",
    "skills",
    "relics",
    "relicDropRules",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "balanceVersion": {
      "type": "integer",
      "minimum": 1
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "gemstones": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/gemstone"
      }
    },
    "monsters": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/monster"
      }
    },
    "skills": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "relics": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/relic"
      }
    },
    "relicDropRules": {
      "$ref": "#/$defs/relicDropRules"
    }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attackPower",
        "attackRadiusWorldUnits",
        "attackCooldownSeconds",
        "criticalChancePercent",
        "bossDamageMultiplier",
        "normalFieldDurationSeconds"
      ],
      "properties": {
        "attackPower": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "attackRadiusWorldUnits": {
          "type": "number",
          "minimum": 5e-324
        },
        "attackCooldownSeconds": {
          "type": "number",
          "minimum": 0.05
        },
        "criticalChancePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "bossDamageMultiplier": {
          "type": "number",
          "minimum": 5e-324
        },
        "normalFieldDurationSeconds": {
          "type": "number",
          "minimum": 15,
          "maximum": 30
        }
      }
    },
    "gemstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "amount"
      ],
      "properties": {
        "id": {
          "enum": [
            "gem.garnet",
            "gem.topaz",
            "gem.amethyst",
            "gem.sapphire",
            "gem.diamond",
            "gem.dragon"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "amount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "productionCount",
        "hitPoints",
        "spawnIntervalSeconds",
        "garnetReward",
        "gemstoneId",
        "gemstoneAmount",
        "gemstoneChancePercent",
        "behaviorType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^monster\\.(0[1-9]|10)$"
        },
        "enabled": {
          "type": "boolean"
        },
        "productionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "hitPoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "spawnIntervalSeconds": {
          "type": "number",
          "minimum": 0.1
        },
        "garnetReward": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gemstoneId": {
          "$ref": "#/$defs/gemstone/properties/id"
        },
        "gemstoneAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gemstoneChancePercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "behaviorType": {
          "type": "integer",
          "enum": [
            0
          ],
          "description": "Legacy MonsterBehaviorType field retained as None = 0. Species traits and movement are configured by MonsterDefinition behavior profiles."
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled"
      ],
      "properties": {
        "id": {
          "enum": [
            "skill.tornado",
            "skill.headshot",
            "skill.thunder",
            "skill.flame_exhaust",
            "skill.magic_ball",
            "skill.laser",
            "skill.pet_baby_dragon"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "upgrades": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skillUpgrade"
          }
        }
      }
    },
    "skillUpgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statId",
        "delta"
      ],
      "properties": {
        "statId": {
          "type": "string",
          "minLength": 1
        },
        "delta": {
          "type": "number"
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criticalDamageMultiplier",
        "globalAliveLimit",
        "perMonsterAliveLimit",
        "bossFieldDurationSeconds"
      ],
      "properties": {
        "criticalDamageMultiplier": {
          "type": "number",
          "minimum": 1
        },
        "globalAliveLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "perMonsterAliveLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 80
        },
        "bossFieldDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "relic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owned",
        "sourceMonsterId",
        "dropChancePercent",
        "effectId",
        "effectValue",
        "effectValue2"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^relic\\.[a-z0-9_]+$"
        },
        "owned": {
          "type": "boolean"
        },
        "sourceMonsterId": {
          "type": "string",
          "pattern": "^monster\\.(0[1-9]|10)$"
        },
        "dropChancePercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "effectId": {
          "enum": [
            "cursorAttackDamagePercent", "autoSkillDamagePercent", "petDamagePercent",
            "petMoveSpeedPercent", "petAttackIntervalReductionPercent",
            "normalFieldDurationBonusSeconds", "areaSkillRadiusPercent",
            "criticalDamageMultiplierBonus", "petDoubleDamageChancePercent",
            "lowHealthExecuteChancePercent", "bonusGemDropChancePercent",
            "petAttackRadiusPercent", "garnetKillRewardPercent",
            "petDetectionRadiusPercent", "monsterSpawnIntervalReductionPercent",
            "cursorAttackRadiusPercent", "fullHealthFirstHitDamagePercent",
            "autoSkillCooldownReductionPercent", "bossDamagePercent",
            "monsterKillRewardPercent"
          ]
        },
        "effectValue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "effectValue2": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "relicDropRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPerKill",
        "candidatePolicy",
        "resolution",
        "preserveBaseChanceAfterAcquisition"
      ],
      "properties": {
        "maxPerKill": {
          "const": 1
        },
        "candidatePolicy": {
          "const": "unownedOnly"
        },
        "resolution": {
          "const": "sumFixedChanceThenWeightedPick"
        },
        "preserveBaseChanceAfterAcquisition": {
          "const": true
        }
      }
    }
  }
}
