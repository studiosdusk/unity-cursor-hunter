{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cursor Hunter progression configuration v2 (not combat input)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentVersion",
    "locale",
    "description",
    "progression",
    "entities"
  ],
  "properties": {
    "documentVersion": {
      "const": 2
    },
    "locale": {
      "const": "en"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "progression": {
      "$ref": "#/$defs/progression"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 34,
      "maxItems": 34
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "valueLabel",
        "cost",
        "currencyId",
        "requiredBossTier",
        "prerequisiteNodeId",
        "startsUnlocked",
        "operation",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "valueLabel": {
          "type": "string"
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "currencyId": {
          "type": "string",
          "minLength": 1
        },
        "requiredBossTier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "prerequisiteNodeId": {
          "type": "string"
        },
        "startsUnlocked": {
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "baseline",
            "set",
            "multiply",
            "enable"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tab",
        "nodes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tab": {
          "enum": [
            "stats",
            "skills",
            "monsters"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      }
    },
    "bossReward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "garnetReward",
        "gemstoneId",
        "gemstoneAmount"
      ],
      "properties": {
        "id": {
          "enum": [
            "boss.v1",
            "boss.v2",
            "boss.v3",
            "boss.v4",
            "boss.v5"
          ]
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "garnetReward": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "gemstoneId": {
          "enum": [
            "gem.garnet",
            "gem.topaz",
            "gem.amethyst",
            "gem.sapphire",
            "gem.diamond",
            "gem.dragon"
          ]
        },
        "gemstoneAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "savedProgressPolicy",
        "initialBossTier",
        "scaleSkillDamageWithAttack",
        "categories",
        "bossRewards"
      ],
      "properties": {
        "savedProgressPolicy": {
          "enum": [
            "overlay",
            "fileOnly"
          ]
        },
        "initialBossTier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "scaleSkillDamageWithAttack": {
          "type": "boolean"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          },
          "minItems": 23,
          "maxItems": 23
        },
        "bossRewards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bossReward"
          },
          "minItems": 5,
          "maxItems": 5
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "prefabKey"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "prefabKey": {
          "type": "string"
        }
      }
    }
  }
}
